{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "module": "preserve",
    "isolatedModules": true,
    "emitDecoratorMetadata": false,
    "types": ["jest", "angular", "node"],
    "target": "ES2016",
    "esModuleInterop": true,
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"]
}
