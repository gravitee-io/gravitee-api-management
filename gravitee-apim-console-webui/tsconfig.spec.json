{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "module": "CommonJs",
    // ts-jest transpiles each file on its own; make the compiler enforce what that assumes.
    "isolatedModules": true,
    // Nothing reads decorator metadata here — no reflect-metadata polyfill, no Reflect.getMetadata,
    // and Ivy does not need it. Emitting it under isolatedModules only produces incomplete data.
    "emitDecoratorMetadata": false,
    "types": ["jest", "angular", "node"],
    "target": "ES2016",
    "esModuleInterop": true
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"]
}
