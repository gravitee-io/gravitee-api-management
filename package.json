    "scripts": {
        "build": "nx run-many -t build",
        "test": "nx run-many -t test",
        "lint": "nx run-many -t lint",
        "lint:fix": "nx run-many -t lint --fix",
        "lint:eslint": "nx run-many -t lint-eslint",
        "lint:license": "nx run-many -t lint-license",
        "prettier": "nx format:check --libs-and-apps && nx format:check --files=nx.json,package.json,jest.config.js",
        "prettier:all": "nx run-many -t lint-prettier --all --exclude-task-dependencies && nx format:check --files=nx.json,package.json,jest.config.js",
        "prettier:fix": "nx format:write --libs-and-apps && nx format:write --files=nx.json,package.json,jest.config.js",
        "affected:build": "nx affected -t build",
        "affected:test": "nx affected -t test",
        "affected:lint": "nx affected -t lint",
        "affected:lint:fix": "nx affected -t lint --fix",
        "affected:lint:eslint": "nx affected -t lint-eslint",
        "affected:lint:license": "nx affected -t lint-license",
        "graph": "nx graph",
        "console:serve": "NODE_OPTIONS=--max_old_space_size=7168 nx serve console",
        "console:serve:apim-master": "BACKEND_ENV=apim-master-api.team-apim.gravitee.dev NODE_OPTIONS=--max_old_space_size=7168 nx serve console",
        "console:serve:apim-gko": "BACKEND_ENV=apim-dev-api.team-gko.gravitee.dev NODE_OPTIONS=--max_old_space_size=7168 nx serve console",
        "console:build": "NODE_OPTIONS=--max_old_space_size=7168 nx build console",
        "console:build:prod": "NODE_OPTIONS=--max_old_space_size=7168 nx build console --configuration=production",
        "console:test": "yarn console:type-check && nx test console",
        "console:type-check": "tsc --noEmit -p gravitee-apim-console-webui/tsconfig.typecheck.json",
        "console:test:ci": "yarn console:type-check && node --max-old-space-size=10240 --expose-gc ./node_modules/.bin/jest --config gravitee-apim-console-webui/jest.config.js --ci --maxWorkers=7 --collectCoverage=true --logHeapUsage && node scripts/rewrite-lcov-for-sonar.js gravitee-apim-console-webui",
        "console:storybook": "nx storybook console",
        "portal-next:serve": "NODE_OPTIONS=--max_old_space_size=7168 nx serve portal-next",
        "portal-next:serve:apim-master": "BACKEND_ENV=apim-master-api.team-apim.gravitee.dev NODE_OPTIONS=--max_old_space_size=7168 nx serve portal-next",
        "portal-next:build": "NODE_OPTIONS=--max_old_space_size=8192 nx build portal-next",
        "portal-next:build:prod": "NODE_OPTIONS=--max_old_space_size=8192 nx build portal-next --configuration=production",
        "portal-next:test": "nx test portal-next",
        "portal-next:test:ci": "NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' jest --config gravitee-apim-portal-webui-next/jest.config.js --ci --collectCoverage=true --maxWorkers=2 --logHeapUsage && node scripts/rewrite-lcov-for-sonar.js gravitee-apim-portal-webui-next",
        "portal-next:storybook": "nx storybook portal-next",
        "markdown:storybook": "nx storybook markdown",
        "markdown:test": "nx test markdown",
        "dashboard:storybook": "nx storybook dashboard",
        "dashboard:test": "nx test dashboard",
        "clean": "rm -rf gravitee-apim-console-webui/node_modules gravitee-apim-console-webui/.angular gravitee-apim-console-webui/dist gravitee-apim-console-webui/dist-lib gravitee-apim-portal-webui-next/node_modules gravitee-apim-portal-webui-next/.angular gravitee-apim-portal-webui-next/dist && echo '✅ Clean done.'",
        "gamma-console:serve": "nx serve gamma-console",
        "gamma-console:build": "nx build gamma-console",
        "gamma-console:build:prod": "nx build gamma-console --configuration=production",
        "gamma-console:test": "nx test gamma-console",
        "gamma-console:test:ci": "nx test gamma-console --coverage --maxWorkers=4",
        "gamma-console:storybook": "nx storybook gamma-console",
        "gamma-console:build-storybook": "nx build-storybook gamma-console",
        "postinstall": "yarn clean"
    },
    "scarfSettings": {
        "enabled": false
    },
    "packageManager": "yarn@4.1.1",
    "resolutions": {
        "nwsapi": "2.2.25",
        "@angular-builders/custom-webpack/@angular-devkit/build-angular": "20.3.14",
        "@angular-builders/custom-webpack/webpack": "5.107.2"
    }
