{
    "id": "gravitee-secret-rotation-update",
    "name": "gravitee-secret-rotation-update",
    "gravitee": "4.0.0",
    "type": "proxy",
    "listeners": [
        {
            "type": "http",
            "paths": [
                {
                    "path": "/rotation-update"
                }
            ],
            "entrypoints": [
                {
                    "type": "http-proxy"
                }
            ]
        }
    ],
    "endpointGroups": [
        {
            "name": "default-group",
            "type": "http-proxy",
            "endpoints": [
                {
                    "name": "default",
                    "type": "http-proxy",
                    "weight": 1,
                    "inheritConfiguration": false,
                    "configuration": {
                        "target": "http://localhost:8080/endpoint"
                    },
                    "sharedConfigurationOverride": {
                        "headers": [
                            {
                                "name": "X-Plain",
                                "value": "{#secrets.get('/gravitee/rotation-update-key:value?envId=DEFAULT')}"
                            },
                            {
                                "name": "X-Reload",
                                "value": "{#secrets.get('/gravitee/rotation-update-key:value?envId=DEFAULT&renewable=true&reloadOnChange=true')}"
                            },
                            {
                                "name": "X-Dictionary",
                                "value": "{#secrets.get(#dictionaries['rotation']['update']?reloadOnChange=true)}"
                            },
                            {
                                "name": "X-Property",
                                "value": "{#secrets.get(#api.properties['update']?reloadOnChange=true)}"
                            }
                        ],
                        "http": {
                            "connectTimeout": 3000,
                            "readTimeout": 60000
                        }
                    }
                }
            ]
        }
    ],
    "flows": [
        {
            "name": "flow-1",
            "enabled": true,
            "selectors": [
                {
                    "type": "http",
                    "path": "/",
                    "pathOperator": "START_WITH",
                    "methods": ["GET"]
                }
            ]
        }
    ],
    "analytics": {
        "enabled": false
    },
    "properties": [
        {
            "key": "update",
            "value": "/gravitee/rotation-update-key:value?envId=DEFAULT&renewable=true",
            "encrypted": false,
            "dynamic": false
        }
    ]
}
