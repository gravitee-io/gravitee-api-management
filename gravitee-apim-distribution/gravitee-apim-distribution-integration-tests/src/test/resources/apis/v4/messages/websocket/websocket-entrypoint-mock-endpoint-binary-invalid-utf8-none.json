{
  "id": "websocket-mock-binary-invalid-utf8-none",
  "name": "websocket-mock-binary-invalid-utf8-none",
  "apiVersion": "1.0",
  "definitionVersion": "4.0.0",
  "type": "message",
  "description": "api v4 using Websocket entrypoint and Mock endpoint",
  "listeners": [
    {
      "type": "http",
      "paths": [
        {
          "path": "/binary-invalid-utf8-none"
        }
      ],
      "entrypoints": [
        {
          "type": "websocket",
          "qos": "none",
          "configuration": {
            "subscriber": {
              "enabled": true,
              "frameType": "BINARY"
            },
            "publisher": {
              "enabled": false
            }
          }
        }
      ]
    }
  ],
  "endpointGroups": [
    {
      "name": "default-group",
      "type": "mock",
      "endpoints": [
        {
          "name": "default",
          "type": "mock",
          "weight": 1,
          "inheritConfiguration": false,
          "configuration": {
            "messageInterval": 10,
            "messageContent": "message",
            "messageCount": 5
          }
        }
      ]
    }
  ],
  "flows": [
    {
      "name": "Invalid UTF-8 message",
      "enabled": true,
      "subscribe": [
        {
          "name": "Invalid UTF-8 message",
          "description": "Replace one message with bytes that are not valid UTF-8",
          "enabled": true,
          "policy": "invalid-utf8-message"
        }
      ]
    }
  ],
  "analytics": {
    "enabled": false
  }
}
