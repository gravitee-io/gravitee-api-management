{
  "id": "websocket-mock-unset-auto",
  "name": "websocket-mock-unset-auto",
  "apiVersion": "1.0",
  "definitionVersion": "4.0.0",
  "type": "message",
  "description": "api v4 using Websocket entrypoint and Mock endpoint",
  "listeners": [
    {
      "type": "http",
      "paths": [
        {
          "path": "/unset-auto"
        }
      ],
      "entrypoints": [
        {
          "type": "websocket",
          "qos": "auto",
          "configuration": {
            "subscriber": {
              "enabled": true
            },
            "publisher": {
              "enabled": false
            }
          }
        }
      ]
    }
  ],
  "endpointGroups": [
    {
      "name": "default-group",
      "type": "mock",
      "endpoints": [
        {
          "name": "default",
          "type": "mock",
          "weight": 1,
          "inheritConfiguration": false,
          "configuration": {
            "messageInterval": 10,
            "messageContent": "message",
            "messageCount": 5
          }
        }
      ]
    }
  ],
  "flows": [],
  "analytics": {
    "enabled": false
  }
}
