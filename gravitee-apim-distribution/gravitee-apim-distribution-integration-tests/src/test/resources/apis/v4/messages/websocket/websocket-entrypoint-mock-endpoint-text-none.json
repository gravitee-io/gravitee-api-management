{
    "id": "websocket-mock-text-none",
    "name": "websocket-mock-text-none",
    "apiVersion": "1.0",
    "definitionVersion": "4.0.0",
    "type": "message",
    "description": "api v4 using Websocket entrypoint and Mock endpoint",
    "listeners": [
        {
            "type": "http",
            "paths": [
                {
                    "path": "/text-none"
                }
            ],
            "entrypoints": [
                {
                    "type": "websocket",
                    "qos": "none",
                    "configuration": {
                        "subscriber": {
                            "enabled": true,
                            "frameType": "TEXT"
                        },
                        "publisher": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    ],
    "endpointGroups": [
        {
            "name": "default-group",
            "type": "mock",
            "endpoints": [
                {
                    "name": "default",
                    "type": "mock",
                    "weight": 1,
                    "inheritConfiguration": false,
                    "configuration": {
                        "messageInterval": 10,
                        "messageContent": "message",
                        "messageCount": 5
                    }
                }
            ]
        }
    ],
    "flows": [],
    "analytics": {
        "enabled": false
    }
}
