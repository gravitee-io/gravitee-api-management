<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <!--
            The organisation parent, like every other Gravitee deliverable — not the product one.
            The distribution assembles the product, it is not part of it. Everything it needs from
            the product side comes through the gravitee-apim-bom import below, pinned at
            ${apim.server.version}, so there is a single point of coupling to the engine.
        -->
        <groupId>io.gravitee</groupId>
        <artifactId>gravitee-parent</artifactId>
        <version>25.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.gravitee.apim.distribution</groupId>
    <artifactId>gravitee-apim-distribution</artifactId>
    <version>${revision}${sha1}${changelist}</version>
    <packaging>pom</packaging>

    <name>Gravitee.io APIM - Distribution</name>
    <description>
        Umbrella of the APIM distribution. Groups the plugin bundle manifest
        (gravitee-apim-distribution-standalone, which parents the gateway/rest-api standalone
        distributions) and the Elasticsearch index mappings.
    </description>

    <properties>
        <!--
            The distribution carries its own CI-friendly version properties: gravitee-parent does not
            define them, and this reactor now sets its own version. Kept in step with the engine for
            now — the two release together — which is what makes a later split of the two cadences a
            change of these three lines rather than a restructuring.
        -->
        <revision>4.13.0</revision>
        <sha1 />
        <changelist>-SNAPSHOT</changelist>

        <!--
            The APIM engine this distribution assembles: a released version, so the distribution can
            be built and released on its own — a plugin bump needs no engine release.

            Advancing it is the deliberate act of shipping a new engine, reviewed like any other
            change. Bump it when a new engine version is released.

            Development and pull-request builds do not use this value: they activate the
            engine-snapshot profile below to assemble the engine currently being worked on. Building
            without that profile assembles the released engine, which is what a release does and
            almost never what you want locally — the Taskfile handles it for you.
        -->
        <apim.server.version>4.12.14</apim.server.version>

        <!--
            Versions shared with the engine. They are declared here as well because the distribution
            uses them directly and must keep resolving them once it no longer inherits the root pom.
            Copies on purpose, not moves: the engine still needs its own. Keep them aligned when
            bumping either side.
        -->
        <gravitee-connector-http.version>6.0.0</gravitee-connector-http.version>
        <gravitee-node.version>9.4.1</gravitee-node.version>
        <grpc-java.version>1.65.0</grpc-java.version>
        <jna.version>5.16.0</jna.version>
        <mariadb-java-client.version>3.5.6</mariadb-java-client.version>
        <mongo.version>5.3.1</mongo.version>
        <mssql-jdbc.version>12.10.2.jre11</mssql-jdbc.version>
        <postgresql.version>42.7.11</postgresql.version>
        <protobuf-java.version>3.25.5</protobuf-java.version>
        <vertx.version>5.0.12</vertx.version>

        <!--
            Assembly poms are not published. They were deployed because the distribution happened to
            sit in the product reactor, not because anyone consumes them. Previously published
            versions stay where they are; this only stops new ones from appearing. Stated explicitly
            so it reads as a decision rather than a side effect of leaving the reactor, and so a
            future release job cannot publish them by accident.

            es-index-mappings opts back in: it is the one module here that produces a real artifact.
        -->
        <maven.deploy.skip>true</maven.deploy.skip>

        <!-- Build plugins the distribution drives itself -->
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
        <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
        <maven-clean-plugin.version>3.2.0</maven-clean-plugin.version>
        <flatten-maven-plugin.version>1.7.2</flatten-maven-plugin.version>

