    </profile>
    <profile>
      <id>reporter-modules</id>
      <activation>
        <property>
          <name>reporter-modules</name>
          <value>true</value>
        </property>
      </activation>
      <modules>
        <module>gravitee-apim-reporter</module>
      </modules>
    </profile>
    <profile>
      <id>repository-modules</id>
      <activation>
        <property>
          <name>repository-modules</name>
          <value>true</value>
        </property>
      </activation>
      <modules>
        <module>gravitee-apim-repository</module>
      </modules>
    </profile>
    <profile>
      <id>integration-tests-modules</id>
      <activation>
        <property>
          <name>integration-tests-modules</name>
          <value>true</value>
        </property>
      </activation>
      <modules>
        <module>gravitee-apim-distribution/gravitee-apim-distribution-integration-tests</module>
      </modules>
    </profile>
  </profiles>
</project>
