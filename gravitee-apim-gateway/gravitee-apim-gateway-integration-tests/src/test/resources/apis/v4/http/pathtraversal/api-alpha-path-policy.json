{
  "id": "alpha-path-policy",
  "name": "alpha-path-policy",
  "gravitee": "4.0.0",
  "type": "proxy",
  "listeners": [
    {
      "type": "http",
      "paths": [
        {
          "path": "/alpha/api/"
        }
      ],
      "entrypoints": [
        {
          "type": "http-proxy"
        }
      ]
    }
  ],
  "endpointGroups": [
    {
      "name": "default-group",
      "type": "http-proxy",
      "endpoints": [
        {
          "name": "default",
          "type": "http-proxy",
          "weight": 1,
          "inheritConfiguration": false,
          "configuration": {
            "target": "http://localhost:8080/alpha/api"
          },
          "sharedConfigurationOverride": {
            "http": {
              "connectTimeout": 3000,
              "readTimeout": 60000
            }
          }
        }
      ]
    }
  ],
  "flows": [
    {
      "name": "observe the path",
      "enabled": true,
      "selectors": [
        {
          "type": "http",
          "path": "/",
          "pathOperator": "START_WITH",
          "methods": []
        }
      ],
      "request": [],
      "response": [
        {
          "name": "Path to header",
          "enabled": true,
          "policy": "path-to-header",
          "configuration": {}
        }
      ]
    }
  ],
  "analytics": {
    "enabled": false
  }
}
