{
  "id": "disabled-internal-flow",
  "name": "disabled-internal-flow",
  "gravitee": "4.0.0",
  "type": "proxy",
  "listeners": [
    {
      "type": "http",
      "paths": [
        {
          "path": "/disabled-internal-flow"
        }
      ],
      "entrypoints": [
        {
          "type": "http-proxy"
        }
      ]
    }
  ],
  "endpointGroups": [
    {
      "name": "default-group",
      "type": "http-proxy",
      "endpoints": [
        {
          "name": "default",
          "type": "http-proxy",
          "weight": 1,
          "inheritConfiguration": false,
          "configuration": {
            "target": "http://localhost:8080/endpoint"
          }
        }
      ]
    }
  ],
  "flows": [
    {
      "name": "api",
      "enabled": true,
      "selectors": [
        {
          "type": "http",
          "path": "/",
          "pathOperator": "START_WITH"
        }
      ],
      "request": [
        {
          "name": "flow-trace",
          "enabled": true,
          "policy": "flow-trace",
          "configuration": {
            "name": "api-request"
          }
        }
      ],
      "response": [
        {
          "name": "flow-trace",
          "enabled": true,
          "policy": "flow-trace",
          "configuration": {
            "name": "api-response"
          }
        }
      ]
    }
  ],
  "internalFlow": {
    "name": "internal",
    "enabled": false,
    "request": [
      {
        "name": "flow-trace",
        "enabled": true,
        "policy": "flow-trace",
        "configuration": {
          "name": "internal-request"
        }
      }
    ],
    "response": [
      {
        "name": "flow-trace",
        "enabled": true,
        "policy": "flow-trace",
        "configuration": {
          "name": "internal-response"
        }
      }
    ]
  },
  "analytics": {
    "enabled": false
  }
}
